rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Personnages de chaque compte : seul le propriétaire y accède
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /adventures/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.gm == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.gm == request.auth.uid;
      allow delete: if request.auth != null && resource.data.gm == request.auth.uid;
      // Le MJ modifie son aventure ; transfert du rôle de MJ vers son compte à la connexion
      allow update: if request.auth != null && (resource.data.gm == request.auth.uid
        || (resource.data.get('claim', '') != '' && request.resource.data.get('claimProof', '') == resource.data.claim
            && request.resource.data.gm == request.auth.uid));

      match /members/{memberId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/adventures/$(code)).data.gm == request.auth.uid);
      }
    }
  }
}
