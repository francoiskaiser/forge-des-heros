rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /adventures/{code} {
      // Lire une aventure : il faut connaître son code
      allow get: if request.auth != null;
      // Lister : uniquement ses propres aventures de MJ
      allow list: if request.auth != null && resource.data.gm == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.gm == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.gm == request.auth.uid;

      match /members/{memberId} {
        allow read: if request.auth != null;
        // Chaque joueur n'écrit que sa propre fiche
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
        // Le joueur peut partir, le MJ peut retirer quelqu'un
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/adventures/$(code)).data.gm == request.auth.uid);
      }
    }
  }
}
