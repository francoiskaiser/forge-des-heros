rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Personnages de chaque compte : seul le propriétaire y accède
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Support : chacun peut envoyer un message, personne ne peut lire depuis l'app
    // (les messages se consultent dans la console Firebase › Firestore › feedback)
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.type in ['bug', 'idea'];
      allow read, update, delete: if false;
    }

    match /adventures/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.gm == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.gm == request.auth.uid;
      allow delete: if request.auth != null && resource.data.gm == request.auth.uid;
      // Le MJ modifie son aventure ; transfert du rôle de MJ vers son compte à la connexion
      allow update: if request.auth != null && (resource.data.gm == request.auth.uid
        || (resource.data.get('claim', '') != '' && request.resource.data.get('claimProof', '') == resource.data.claim
            && request.resource.data.gm == request.auth.uid));

      // Contenu maison : lu par tous ceux qui ont le code ; modifiable par son auteur ou le MJ
      match /homebrew/{hid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/adventures/$(code))
          && request.resource.data.by == request.auth.uid
          && request.resource.data.n is string && request.resource.data.n.size() <= 120
          && request.resource.data.d is string && request.resource.data.d.size() <= 6000
          && request.resource.data.type in ['sub', 'bg', 'feat', 'spell', 'item'];
        allow update: if request.auth != null
          && (resource.data.by == request.auth.uid || get(/databases/$(database)/documents/adventures/$(code)).data.gm == request.auth.uid)
          && request.resource.data.by == resource.data.by
          && request.resource.data.n is string && request.resource.data.n.size() <= 120
          && request.resource.data.d is string && request.resource.data.d.size() <= 6000;
        allow delete: if request.auth != null
          && (resource.data.by == request.auth.uid || get(/databases/$(database)/documents/adventures/$(code)).data.gm == request.auth.uid);
      }

      match /members/{memberId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/adventures/$(code)).data.gm == request.auth.uid);
      }
    }
  }
}
